# Copiar a ml/.env y completar. Nunca subir el .env.

# Datos con los que se trabaja: simulado (por defecto; "mock" es alias) o real.
DATASET=simulado

# Clave que exige el servicio en la cabecera X-API-Key (todo menos /health).
# Debe ser igual a ML_API_KEY del backend. Genera una larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_API_KEY=

# Carpeta de los modelos entrenados (opcional; por defecto ml/artefactos/).
# ML_ARTEFACTOS_DIR=

# Supabase: lectura de destinos (exportar_destinos.py) con la publishable key.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo para cargar_datos_reales.py --subir-a-supabase (escribe en la tabla ocupacion).
# Es la secret / service role key: solo en tu PC, nunca en la app ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Variables de entorno (nunca subir secretos)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Node.js
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/*
!.yarn/releases
coverage/
dist/
build/
*.tsbuildinfo

# ==========================================
# React Native / Expo
# ==========================================
.expo/
.expo-shared/
web-build/
expo-env.d.ts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
# Metro
.metro-health-check*
# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties
*.apk
*.aab
# iOS
ios/Pods/
ios/build/
*.xcworkspace/xcuserdata/
DerivedData/

# ==========================================
# Python
# ==========================================
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ==========================================
# Supabase CLI (local)
# ==========================================
supabase/.branches/
supabase/.temp/

# ==========================================
# Herramientas locales (Claude Code, MCP, graphify)
# ==========================================
.claude/
CLAUDE.md
Graphifyy.md
MVP.md
.mcp.json
graphify-out/

# ==========================================
# Material local que no forma parte del repositorio
# ==========================================

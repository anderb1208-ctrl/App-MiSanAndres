docs/referencia-frontend/
docs/Entregable2_MiSanAndres.md

# ==========================================
# Archivos temporales
# ==========================================
*.tmp
*.temp
*.bak
*.swp
*~
~$*
.DS_Store

# ==========================================
# Logs
# ==========================================
logs/
*.log

# ==========================================
# Windows
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# ==========================================
# VS Code
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace
.history/
.claude/

# Caché de Overpass del script de geolocalización
backend/scripts/ubicaciones/.cache/

# Servicio de ML: entorno, datos y modelos generados (se regeneran con los scripts)
ml/.venv/
ml/.pytest_cache/
ml/**/__pycache__/
ml/datos/destinos.csv
ml/datos/mock/
# Dataset simulado (~24 MB): se regenera igual con python generar_dataset_simulado.py (semilla 42)
ml/datos/dataset_ocupacion_san_andres.csv
ml/datos/procesado_real/
ml/datos/real/*
!ml/datos/real/.gitkeep
ml/modelos/*
!ml/modelos/.gitkeep
# El modelo ganador es liviano (< 1 MB): se versiona para que el build de Render no entrene.
!ml/modelos/modelo_ocupacion.joblib
!ml/modelos/modelo_ocupacion.json
ml/reportes/*
!ml/reportes/.gitkeep
# Reportes del entregable (los de cada entrenamiento rápido no se suben)
!ml/reportes/calidad_dataset.md
!ml/reportes/calidad_*.png
!ml/reportes/comparacion_modelos.md
!ml/reportes/comparacion_modelos.csv
!ml/reportes/comparacion_*.png
!ml/reportes/ganador.json

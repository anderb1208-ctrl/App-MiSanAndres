# ==========================================
.claude/
CLAUDE.md
Graphifyy.md
MVP.md
.mcp.json
graphify-out/

# ==========================================
# Material local que no forma parte del repositorio
# ==========================================
# Documentación del proyecto (entregable, decisiones, datos por verificar, revisión de
# ubicaciones y referencia visual): se guarda en cada PC, no en el repositorio. La app, el
# backend y el servicio de ML no la usan; los scripts de ubicaciones la crean si falta.
docs/

# ==========================================
# Archivos temporales
# ==========================================
*.tmp
*.temp
*.bak
*.swp
*~
~$*
.DS_Store

# ==========================================
# Logs
# ==========================================
logs/
*.log

# ==========================================
# Windows
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# ==========================================
# VS Code
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace
.history/
.claude/

# Caché de Overpass del script de geolocalización
backend/scripts/ubicaciones/.cache/

# Servicio de ML (ml/)
# - Se ignoran: entorno, cachés de Python y pytest, y los CSV grandes o locales.
# - Se versionan: ml/artefactos/ COMPLETO (los tres modelos, sus metadatos, ganador.json y
#   baseline.json: Render no entrena), los CSV pequeños de datos y los reportes del entregable.
ml/.venv/
ml/.pytest_cache/
ml/**/__pycache__/
# Exportado de Supabase en cada PC (el versionado es destinos_respaldo.csv)
ml/datos/destinos.csv
# Dataset simulado (~24 MB): se regenera igual con python -m misanandres_ml.datos.generar_dataset_simulado (semilla 42)
ml/datos/dataset_ocupacion_san_andres.csv
ml/datos/procesado_real/
ml/datos/real/*
!ml/datos/real/.gitkeep
# Reportes de cada entrenamiento rápido (los de la comparación sí se versionan)
ml/reportes/entrenamiento_*.md

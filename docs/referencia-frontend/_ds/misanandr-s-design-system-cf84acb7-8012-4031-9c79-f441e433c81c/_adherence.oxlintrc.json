{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/destinos/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk|Material Symbols Outlined))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk, Material Symbols Outlined."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onChange|floating|style|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: items, active, onChange, floating, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|glass|glass-dark|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'glass' | 'glass-dark' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|location|image|occupancy|note|layout|favorite|onFavorite|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DestinoCard> doesn't accept that prop. Declared props: name, category, location, image, occupancy, note, layout, favorite, onFavorite, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinoCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:featured|horizontal|list|map)$/]",
        "message": "<DestinoCard> layout must be one of 'featured' | 'horizontal' | 'list' | 'map'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|icon|accent|glass|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, active, icon, accent, glass, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:navy|turquoise)$/]",
        "message": "<FilterChip> accent must be one of 'navy' | 'turquoise'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|radius|padding|style|onClick|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: children, tone, radius, padding, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|strong|dark)$/]",
        "message": "<GlassPanel> tone must be one of 'light' | 'strong' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|fill|weight|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, fill, weight, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|active|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, tone, size, active, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:glass-dark|glass|plain|tonal)$/]",
        "message": "<IconButton> tone must be one of 'glass-dark' | 'glass' | 'plain' | 'tonal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicadorOcupacion'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|level|variant|showValue|size|glass|capacity|key|ref|className|style|children)$/]",
        "message": "<IndicadorOcupacion> doesn't accept that prop. Declared props: value, level, variant, showValue, size, glass, capacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicadorOcupacion'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:low|mid|high)$/]",
        "message": "<IndicadorOcupacion> level must be one of 'low' | 'mid' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicadorOcupacion'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:badge|bar|gauge)$/]",
        "message": "<IndicadorOcupacion> variant must be one of 'badge' | 'bar' | 'gauge'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicadorOcupacion'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<IndicadorOcupacion> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|occupancy|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MapMarker> doesn't accept that prop. Declared props: active, occupancy, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OcupacionChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|height|highlight|key|ref|className|style|children)$/]",
        "message": "<OcupacionChart> doesn't accept that prop. Declared props: data, height, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|trailingIcon|onTrailing|glass|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, value, onChange, trailingIcon, onTrailing, glass, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|icon|iconTone|control|checked|divider|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SelectRow> doesn't accept that prop. Declared props: label, description, icon, iconTone, control, checked, divider, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectRow'] > JSXAttribute[name.name='iconTone'] > Literal[value!=/^(?:turquoise|neutral|navy|low|mid|high)$/]",
        "message": "<SelectRow> iconTone must be one of 'turquoise' | 'neutral' | 'navy' | 'low' | 'mid' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectRow'] > JSXAttribute[name.name='control'] > Literal[value!=/^(?:checkbox|radio|switch|chevron)$/]",
        "message": "<SelectRow> control must be one of 'checkbox' | 'radio' | 'switch' | 'chevron'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, icon, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|sand|turquoise|glass)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'sand' | 'turquoise' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|type|value|defaultValue|onChange|icon|error|hint|glass|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, placeholder, type, value, defaultValue, onChange, icon, error, hint, glass, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password)$/]",
        "message": "<TextField> type must be one of 'text' | 'email' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onBack|actions|tone|large|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, subtitle, onBack, actions, tone, large, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:glass|dark|transparent)$/]",
        "message": "<TopBar> tone must be one of 'glass' | 'dark' | 'transparent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }

# Copiar a .env y completar. Nunca subir el .env.

# Proyecto de Supabase (Settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Publishable key (sb_publishable_...). El backend NO usa la secret key:
# reenvía el JWT del usuario para que se aplique RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Puerto HTTP del servidor
PORT=3000

# Orígenes permitidos por CORS, separados por coma. Vacío = cualquiera (desarrollo).
CORS_ORIGIN=

# Entorno (development | production | test). En Render: production.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Predicción de ocupación
# heuristico = promedio histórico + factores (por defecto, no necesita nada más)
# ml         = servicio de ml/ (si no responde, la predicción da 503)
# auto       = servicio de ml/ y, si falla o no responde, el heurístico
# ---------------------------------------------------------------------------
PREDICCION_PROVEEDOR=heuristico
# Obligatorias solo con ml o auto: URL del servicio (sin barra final) y su API key
# (la misma ML_API_KEY configurada en el servicio de ml/).
ML_SERVICE_URL=
ML_API_KEY=
# Tiempo máximo de espera al servicio de ML, en milisegundos.
ML_TIMEOUT_MS=2500
# Origen de la tabla ocupacion que usa el heurístico: sintetico (seed) o real.
ORIGEN_DATOS_HISTORICOS=sintetico

# ---------------------------------------------------------------------------
# Clima (Open-Meteo). Todas opcionales: sin definirlas funciona con la API gratuita.
# ---------------------------------------------------------------------------
# open-meteo (por defecto) o ninguno (desactiva el clima: motivoSinClima = no_configurado).
CLIMA_PROVEEDOR=open-meteo
# Espera máxima por intento (ms) y reintentos ante timeout, error de red o HTTP 5xx.
CLIMA_TIMEOUT_MS=6000
CLIMA_REINTENTOS=1
# Solo con la API comercial de Open-Meteo (evita el límite por IP compartida):
# OPEN_METEO_URL=https://customer-api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=
OPEN_METEO_URL=
OPEN_METEO_API_KEY=

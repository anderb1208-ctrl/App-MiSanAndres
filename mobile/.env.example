# Copiar a .env y completar. Nunca subir el .env.
# Expo solo expone al código las variables que empiezan por EXPO_PUBLIC_.

# URL del backend. En un celular físico usa la IP local del PC (no localhost),
# por ejemplo http://192.168.1.50:3000 (ver `ipconfig` en Windows).
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Proyecto de Supabase (Settings > API). Solo la publishable key:
# la secret / service role key NUNCA va en la app.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

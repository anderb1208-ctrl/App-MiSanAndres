# Copiar a .env y completar. Nunca subir el .env.
# Expo solo expone al código las variables que empiezan por EXPO_PUBLIC_, y las
# INCRUSTA en el bundle: después de cambiar este archivo, reinicia con
#   npm run start:limpio      (equivale a: npx expo start --clear)
# o la app seguirá usando el valor anterior.

# URL del backend: sin barra final y sin /v1 (la app agrega /v1).
# Producción (Render):
EXPO_PUBLIC_API_URL=https://app-misanandres.onrender.com
# Backend local en el PC (el celular debe estar en la misma Wi-Fi; usa la IP del PC, no localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Proyecto de Supabase (Settings > API). Solo la publishable key:
# la secret / service role key NUNCA va en la app.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clave de Google Maps SDK for Android (solo para builds propios de Android).
# La lee app.config.ts; NO lleva el prefijo EXPO_PUBLIC_ porque no la usa el código JS.
# En iPhone el mapa es Apple Maps y no necesita clave. Expo Go tampoco la necesita.
# Para EAS Build se configura como variable secreta (ver README, sección "Mapa").
GOOGLE_MAPS_API_KEY=

# Id del proyecto de EAS (lo crea `npx eas init`). Lo necesitan las notificaciones PUSH
# remotas (cierres temporales). Sin él, la app funciona igual con avisos LOCALES.
# No es secreto. En Expo Go, las push remotas solo funcionan en iPhone (ver README).
EAS_PROJECT_ID=
